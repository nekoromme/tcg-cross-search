[Unit]
Description=Personal TCG stock monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tcg-monitor
WorkingDirectory=/opt/tcg-cross-search
EnvironmentFile=/etc/tcg-monitor.env
ExecStart=/usr/bin/node /opt/tcg-cross-search/scripts/monitor-server.mjs
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tcg-monitor

[Install]
WantedBy=multi-user.target
