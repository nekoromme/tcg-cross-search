# 秘密はこの例をコピーしたサーバー上の設定ファイルだけへ記入する。
MONITOR_ACCESS_KEY=REPLACE_WITH_YOUR_64_CHARACTER_MONITOR_KEY
MONITOR_DATA_DIR=/var/lib/tcg-monitor
HOST=127.0.0.1
PORT=8787
MONITOR_PUBLIC_ORIGIN=https://YOUR_PRIVATE_DOMAIN
MONITOR_INTERVAL_SECONDS=30
# Discord通知を使う場合。画面から設定してもよい。
# DISCORD_WEBHOOK_URL=
# 初回移行時だけ設定し、取り込み成功後に外す。
# MONITOR_IMPORT_FILE=/var/lib/tcg-monitor/tcg-monitor-backup.json
